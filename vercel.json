{
  "rewrites": [
    {
      "source": "/j/:code",
      "destination": "/api/j?code=:code"
    },
    {
      "source": "/u/:code",
      "destination": "/api/u?code=:code"
    },
    {
      "source": "/p/:code",
      "destination": "/p/index.html"
    },
    {
      "source": "/s/:code",
      "destination": "/s/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/get",
      "destination": "https://apps.apple.com/app/id6778510429",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}

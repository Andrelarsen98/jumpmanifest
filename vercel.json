{
  "rewrites": [
    {
      "source": "/j/:code",
      "destination": "/api/j?code=:code"
    },
    {
      "source": "/u/:code",
      "destination": "/api/u?code=:code"
    },
    {
      "source": "/p/:code",
      "destination": "/p/index.html"
    },
    {
      "source": "/s/:code",
      "destination": "/s/index.html"
    },
    {
      "source": "/join/:code",
      "destination": "/join/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/dropzones/start",
      "destination": "/dropzones/#pricing",
      "permanent": false
    },
    {
      "source": "/dropzones/start/",
      "destination": "/dropzones/#pricing",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "https://apps.apple.com/us/app/manifest-skydive-play-share/id6778510429",
      "permanent": false
    },
    {
      "source": "/:path([^.,;:!]*[^.,;:!/]):trail([.,;:!]+)",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/opt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
